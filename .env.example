# Generate each key with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Separate keys with commas. One key is also supported.
# The container refuses to start with placeholders or no keys.
API_KEYS=replace-with-a-random-key,replace-with-another-random-key

# Optional (admin.cubus.sh): set a random Bearer token (>= 16 bytes) to enable
# the internal-only :9090 Admin API listener (disabled when unset).
# ADMIN_API_TOKEN=replace-with-a-random-admin-api-token
