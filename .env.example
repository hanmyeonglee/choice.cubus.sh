# Standalone local development PostgreSQL connection string.
# When deployed under cubus.sh, root docker-compose.yml injects DB_BROKER_URL
# automatically and DATABASE_URL is ignored.
# DATABASE_URL=postgresql://choice:choice-local-dev@postgres:5432/choice?sslmode=disable

# Optional (admin.cubus.sh): set a random Bearer token (>= 16 bytes) to enable
# the internal-only :9090 Admin API listener (disabled when unset).
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# ADMIN_API_TOKEN=replace-with-a-random-admin-api-token
